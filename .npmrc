# Tag releases as 0.2.1 rather than npm's default v0.2.1, matching the tags
# already on this repo. Set here rather than as a --tag-version-prefix flag in
# package.json so it works from cmd.exe, PowerShell and bash alike: npm scripts
# run through cmd.exe on Windows, where '' is not quoting and would end up in
# the tag name.
tag-version-prefix=
